{
  "name": "crustacean-map-lib",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "typesVersions": {
    "*": {
      "webgl": [
        "dist/webgl.d.ts"
      ],
      "load": [
        "dist/load.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:dist": "tsc -p tsconfig.json",
    "test": "npm run build:dist && node --test test/core.test.mjs test/farmsville.test.mjs test/package.test.mjs test/screenview.test.mjs test/editor-view.test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:package": "node scripts/test-package.mjs",
    "validate:clean": "node scripts/validate-clean.mjs"
  },
  "peerDependencies": {
    "crustacean-sprite-lib": ">=0.1.0"
  },
  "devDependencies": {
    "crustacean-sprite-lib": "git+https://github.com/mcgrue/crustacean-sprite-lib.git#1b14fe8fa436f70a7cc8673ac6d39f92c3d746fc",
    "typescript": "~4.6.4"
  }
}
